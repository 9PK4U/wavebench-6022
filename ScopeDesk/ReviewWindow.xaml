<Window x:Class="ScopeDesk.ReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScopeDesk"
        Title="{DynamicResource ReviewTitle}" Icon="ScopeDesk.ico" Width="1190" Height="800" MinWidth="840" MinHeight="670"
        WindowStartupLocation="CenterOwner" Background="#0A101B" Foreground="#EEF4FF"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True"
        Closed="ReviewClosed" PreviewKeyDown="ReviewKeyDown">
    <Grid Margin="20,15,20,13">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="SplitChannels" Content="{DynamicResource Tracks}" Width="94" Margin="0,0,12,0" VerticalAlignment="Center"
                          Foreground="{StaticResource Cyan}" Checked="ChannelChanged" Unchecked="ChannelChanged"
                          ToolTip="{DynamicResource TracksHint}"/>
                <Button x:Name="SearchButton" Content="{DynamicResource Search}" Click="ToggleSearchClick" Margin="0,0,12,0"/>
                <Button x:Name="PreviousButton" Content="‹" Click="PreviousClick" MinWidth="37" Padding="7,0"
                        ToolTip="{DynamicResource PreviousFrameHint}" AutomationProperties.Name="{DynamicResource PreviousFrame}"/>
                <Button x:Name="PlayButton" Content="{DynamicResource Play}" Click="PlayClick" MinWidth="140"
                        Style="{StaticResource Primary}" Margin="6,0" ToolTip="{DynamicResource PlaybackHint}"/>
                <Button x:Name="NextButton" Content="›" Click="NextClick" MinWidth="37" Padding="7,0"
                        ToolTip="{DynamicResource NextFrameHint}" AutomationProperties.Name="{DynamicResource NextFrame}"/>
            </StackPanel>
            <StackPanel Margin="0,0,9,0">
                <TextBlock Text="{DynamicResource RecordingReview}" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <TextBlock x:Name="FileLabel" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="11,8,11,7" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="73"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="2,0,2,5">
                    <Button DockPanel.Dock="Right" Content="{DynamicResource FitTimeline}" Click="FitTimelineClick" MinHeight="26" Padding="10,0"
                            ToolTip="{DynamicResource FitTimelineHint}"/>
                    <TextBlock Text="{DynamicResource Timeline}" Style="{StaticResource Section}" VerticalAlignment="Center"/>
                </DockPanel>
                <local:RecordingTimeline x:Name="Timeline" Grid.Row="1"
                    ToolTip="{DynamicResource TimelineHint}"/>
                <DockPanel Grid.Row="2" Margin="2,5,2,0">
                    <TextBlock x:Name="GapLabel" DockPanel.Dock="Right" Foreground="{StaticResource Amber}" FontSize="12"/>
                    <TextBlock x:Name="PositionLabel" Style="{StaticResource Caption}"/>
                </DockPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="10,8,10,8" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="2,0,2,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <CheckBox x:Name="FirstVisible" Content="CH1" Foreground="{StaticResource Cyan}" IsChecked="True"
                                  Checked="ChannelChanged" Unchecked="ChannelChanged" Width="68" VerticalAlignment="Center" Margin="0,0,11,0"/>
                        <CheckBox x:Name="SecondVisible" Content="CH2" Foreground="{StaticResource Amber}" IsChecked="True"
                                  Checked="ChannelChanged" Unchecked="ChannelChanged" Width="68" VerticalAlignment="Center" Margin="0,0,11,0"/>
                        <Button Content="{DynamicResource FitFrame}" Click="FitFrameClick" MinHeight="28" Padding="10,0" Margin="0,0,6,0"/>
                        <Button x:Name="ExportButton" Content="{DynamicResource CsvView}" Click="ExportClick" MinHeight="28" Padding="10,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Waveforms}" Style="{StaticResource Section}" Margin="0,0,9,0"/>
                        <TextBlock x:Name="SampleLabel" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
                <local:Waveform x:Name="Plot" Grid.Row="1" MouseWheel="ZoomPlot" MouseDown="PlotPressed"
                    MouseMove="PanPlot" MouseUp="PlotReleased"
                    ToolTip="{DynamicResource ReviewPlotHint}"/>
                <DockPanel Grid.Row="2" Margin="2,5,2,0">
                    <TextBlock x:Name="FrameInfo" DockPanel.Dock="Right" Style="{StaticResource Caption}"/>
                    <TextBlock Text="{DynamicResource ReviewShortcuts}" Style="{StaticResource Caption}"/>
                </DockPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.32*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Panel}" Padding="11,8">
                <StackPanel>
                    <DockPanel Margin="0,0,0,5">
                        <Button DockPanel.Dock="Right" x:Name="ResetCursorsButton" Content="{DynamicResource Reset}" Click="ResetCursorsClick"
                                MinHeight="25" Padding="10,0"/>
                        <TextBlock Text="{DynamicResource Cursors}" Style="{StaticResource Section}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="CursorTime" Text="Δt —     1/Δt —" FontFamily="Consolas" FontSize="13"/>
                    <TextBlock x:Name="CursorVoltage" Text="ΔV CH1 —     ΔV CH2 —" Style="{StaticResource Caption}" Margin="0,4,0,1"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="11,8">
                <StackPanel>
                    <TextBlock Text="{DynamicResource ChannelMeasurements}" Style="{StaticResource Section}" Margin="0,0,0,7"/>
                    <TextBlock x:Name="FirstMeasures" Foreground="{StaticResource Cyan}" TextTrimming="CharacterEllipsis"/>
                    <local:ExtremaTable x:Name="FirstExtrema" Margin="0,3,0,0"/>
                    <TextBlock x:Name="SecondMeasures" Foreground="{StaticResource Amber}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                    <local:ExtremaTable x:Name="SecondExtrema" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="SearchPanel" Grid.Column="1" Grid.Row="1" Grid.RowSpan="3" Width="234"
                Margin="10,0,0,0" Padding="12" Style="{StaticResource Panel}" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource SearchRecording}" Style="{StaticResource Section}" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="62"/></Grid.ColumnDefinitions>
                        <ComboBox x:Name="SearchMode" SelectedIndex="0" SelectionChanged="SearchModeChanged" AutomationProperties.Name="{DynamicResource SearchCondition}">
                            <ComboBoxItem Content="{DynamicResource AboveThreshold}"/>
                            <ComboBoxItem Content="{DynamicResource ShortPulse}"/>
                        </ComboBox>
                        <ComboBox x:Name="SearchChannel" Grid.Column="2" SelectedIndex="1" AutomationProperties.Name="{DynamicResource SearchChannel}">
                            <ComboBoxItem Content="CH1"/><ComboBoxItem Content="CH2"/>
                        </ComboBox>
                    </Grid>
                    <TextBlock Text="{DynamicResource LevelVolts}" Style="{StaticResource Caption}" Margin="0,9,0,4"/>
                    <TextBox x:Name="ThresholdInput" Text="1" Height="30" Padding="9,4" AutomationProperties.Name="{DynamicResource ThresholdVolts}"
                             Background="{StaticResource Field}" BorderBrush="{StaticResource Edge}" Foreground="{StaticResource Ink}" CaretBrush="{StaticResource Ink}"/>
                    <StackPanel x:Name="WidthCondition" Visibility="Collapsed">
                        <TextBlock Text="{DynamicResource WidthMicroseconds}" Style="{StaticResource Caption}" Margin="0,9,0,4"/>
                        <TextBox x:Name="WidthInput" Text="5" Height="30" Padding="9,4" AutomationProperties.Name="{DynamicResource WidthA11y}"
                                 Background="{StaticResource Field}" BorderBrush="{StaticResource Edge}" Foreground="{StaticResource Ink}" CaretBrush="{StaticResource Ink}"/>
                    </StackPanel>
                    <Button x:Name="FindEventsButton" Content="{DynamicResource Find}" Click="FindEventsClick" Margin="0,10,0,0"/>
                    <TextBlock x:Name="SearchStatus" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,9,0,7"/>
                </StackPanel>
                <ListBox x:Name="SearchResults" Grid.Row="1" SelectionChanged="SearchResultSelected"
                         Background="#0C1725" BorderBrush="{StaticResource Edge}" Foreground="{StaticResource Ink}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{DynamicResource SearchResults}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
